# AssemblyAI API key (Voice Agent + Universal-3.5 Pro streaming). Required.
ASSEMBLYAI_API_KEY=

# Publicly reachable URL for this server (e.g. your cloudflared tunnel, or the Render URL
# in production). AssemblyAI's Voice Agent must be able to reach
# <PUBLIC_BASE_URL>/brain/v1/chat/completions over the internet. Required.
PUBLIC_BASE_URL=

# Bearer secret the stored Voice Agent uses to call this server's Brain endpoint. Required
# — generate a random value, e.g. `openssl rand -hex 32`.
BRAIN_SECRET=

# Which LLM provider the Relay Brain uses: "venice" (default) or "aai-gateway" (routes
# through AssemblyAI's LLM Gateway instead).
LLM_PROVIDER=venice

# Venice API key. Required only when LLM_PROVIDER=venice.
VENICE_API_KEY=

# Model id for the chosen provider, overriding its default. Optional — the venice default
# is the fastest model that passed every Brain benchmark turn with thinking off (see
# DEFAULT_MODEL in apps/server/src/config.ts and VENICE_MODEL_PARAMS in llm/provider.ts).
LLM_MODEL=

# HTTP port. Optional, defaults to 8787.
PORT=

# Trusted reverse-proxy ranges for X-Forwarded-For (Fastify trustProxy), controlling which
# entry is trusted for per-visitor rate limiting behind a reverse proxy (cloudflared,
# Render's load balancer, ...). Leave unset to use the default
# ("loopback,linklocal,uniquelocal"); "false"/"0"/"off" disables proxy trust, "true" trusts
# every peer, or pass a comma-separated list of presets/CIDRs.
TRUST_PROXY=

# "debug" writes structured per-event timing lines to stderr (src/debugLog.ts): Brain
# request/first-token/first-byte timings, relay queue/take/first-audio, Voice Agent and
# caption events, line-state changes. Never logs spoken or typed text. Optional.
LOG_LEVEL=

# Extra JSON body params merged over the provider's per-model defaults on every LLM
# request, e.g. {"reasoning":{"enabled":false}}. Optional.
LLM_PARAMS=
